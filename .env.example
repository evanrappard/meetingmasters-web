# Voorbeeld van .env.local — vul de echte waarden daar in, niet hier.
# .env.local staat in .gitignore; dit bestand staat wél in de openbare repo.

# Sanity — vult de cijfers, klantlogo's en cases op de Nederlandse homepage.
# Ontbreken ze, dan gebruikt de homepage haar vaste teksten en beelden.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# HubSpot — alleen nodig voor de scripts die formulieren aanmaken of bijwerken.
# De site zelf heeft dit niet nodig: de formulieren laden in de browser.
HUBSPOT_PRIVATE_APP_TOKEN=

# Zet de boekingsmodules op de R@venHack-pagina aan (waarde: 1).
NEXT_PUBLIC_RAVENHACK_MODULES=
